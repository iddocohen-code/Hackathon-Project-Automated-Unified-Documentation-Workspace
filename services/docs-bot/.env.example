# Copy this file to .env and fill in the values. .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=
GITHUB_WEBHOOK_SECRET=
SCHEDULER_MODE=instant
SURF_CONSOLE_URL=http://localhost:3000
DOCS_CONTENT_DIR=
# Absolute or repo-relative path for screenshot output (defaults to apps/surf-console/public/docs-screenshots)
SCREENSHOTS_PUBLIC_DIR=
