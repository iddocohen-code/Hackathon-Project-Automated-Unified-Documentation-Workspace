ANTHROPIC_API_KEY=
GITHUB_WEBHOOK_SECRET=
SCHEDULER_MODE=instant
SURF_CONSOLE_URL=
NEXT_PUBLIC_BOT_URL=
# Server-side proxy target for the docs-bot RAG service (never expose as NEXT_PUBLIC_*)
BOT_URL=http://localhost:4000
# docs-bot service
PORT=4000
DOCS_CONTENT_DIR=
# --- Admin editor (optional; manual content editing behind a password gate) ---
# Password to enter /admin (empty = admin login cannot succeed)
ADMIN_PASSWORD=
# Secret used to sign/verify the admin session cookie
ADMIN_SESSION_SECRET=
# Shared token the admin save-proxy sends to the bot (must match the bot's BOT_ADMIN_TOKEN); empty disables admin save
BOT_ADMIN_TOKEN=
# Bot URL the admin save-proxy posts to, server-side (defaults to http://localhost:4000)
BOT_INTERNAL_URL=http://localhost:4000
